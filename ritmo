<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <title>Ritmo de Vida</title>
    <style>
        :root {
            /* Paleta Silenciosa e Contemplativa conforme briefing */
            --bg-color: #FAFAF9; /* Off-white papel */
            --text-main: #44403C; /* Cinza escuro suave */
            --text-light: #78716C;
            --accent: #57534E;
            --border: #E7E5E4;
            
            /* Estados definidos no briefing */
            --state-ok-bg: #E6F4EA; --state-ok-text: #1E4620;
            --state-heavy-bg: #FEE2E2; --state-heavy-text: #7F1D1D;
            --state-neglected-bg: #F3F4F6; --state-neglected-text: #4B5563;
            
            --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            --spacing: 16px;
            --radius: 12px;
        }

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        
        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: var(--font-family);
            margin: 0;
            padding: 0;
            padding-bottom: 80px; /* Espaço para menu inferior */
            line-height: 1.5;
        }

        /* Tipografia */
        h1, h2, h3 { font-weight: 600; margin: 0; letter-spacing: -0.02em; }
        h1 { font-size: 1.25rem; padding: var(--spacing); padding-bottom: 0; }
        p { margin: 0 0 10px 0; color: var(--text-light); font-size: 0.95rem; }
        .date-header { padding: 0 var(--spacing) var(--spacing); color: var(--text-light); font-size: 0.9rem; }

        /* Navegação Inferior */
        .nav-bar {
            position: fixed;
            bottom: 0; left: 0; right: 0;
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(10px);
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: space-around;
            padding: 12px 0;
            z-index: 100;
        }
        .nav-item {
            border: none; background: none;
            color: var(--text-light);
            font-size: 0.8rem; font-weight: 500;
            display: flex; flex-direction: column; align-items: center; gap: 4px;
            cursor: pointer;
        }
        .nav-item.active { color: var(--text-main); font-weight: 700; }
        .nav-icon { font-size: 1.2rem; }

        /* Views */
        .view { display: none; animation: fadeIn 0.3s ease; }
        .view.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }

        /* CHECK-IN STYLES */
        .card {
            background: white;
            margin: var(--spacing);
            padding: var(--spacing);
            border-radius: var(--radius);
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
            border: 1px solid var(--border);
        }
        
        .frente-item { margin-bottom: 24px; }
        .frente-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
        .frente-name { font-weight: 600; font-size: 1.1rem; }
        
        .state-selector { display: flex; gap: 8px; margin-bottom: 8px; }
        .state-btn {
            flex: 1;
            padding: 8px;
            border: 1px solid var(--border);
            background: white;
            border-radius: 8px;
            font-size: 0.9rem;
            color: var(--text-light);
            cursor: pointer;
            transition: all 0.2s;
        }
        /* Cores baseadas nos estados definidos no briefing */
        .state-btn.selected[data-state="ok"] { background: var(--state-ok-bg); color: var(--state-ok-text); border-color: transparent; font-weight: 600; }
        .state-btn.selected[data-state="pesado"] { background: var(--state-heavy-bg); color: var(--state-heavy-text); border-color: transparent; font-weight: 600; }
        .state-btn.selected[data-state="negligenciado"] { background: var(--state-neglected-bg); color: var(--state-neglected-text); border-color: transparent; font-weight: 600; }

        .note-input {
            width: 100%;
            border: none;
            border-bottom: 1px solid var(--border);
            padding: 8px 0;
            font-family: inherit;
            font-size: 0.9rem;
            color: var(--text-main);
            background: transparent;
        }
        .note-input:focus { outline: none; border-bottom-color: var(--text-light); }
        .note-input::placeholder { color: #D6D3D1; font-style: italic; }

        /* TIMELINE & INSIGHTS */
        .timeline-grid { display: grid; grid-template-columns: 80px 1fr; gap: 12px; margin: var(--spacing); }
        .timeline-date { color: var(--text-light); font-size: 0.85rem; text-align: right; padding-top: 4px; }
        .timeline-content { display: flex; flex-direction: column; gap: 6px; border-left: 2px solid var(--border); padding-left: 12px; padding-bottom: 16px; }
        
        .tag { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 16px; font-size: 0.8rem; margin-right: 4px; margin-bottom: 4px; }
        .tag.ok { background: var(--state-ok-bg); color: var(--state-ok-text); }
        .tag.pesado { background: var(--state-heavy-bg); color: var(--state-heavy-text); }
        .tag.negligenciado { background: var(--state-neglected-bg); color: var(--state-neglected-text); }

        .insight-card { background: #F0FDF4; border: 1px solid #DCFCE7; padding: var(--spacing); margin: var(--spacing); border-radius: var(--radius); }
        .insight-card.neutral { background: white; border-color: var(--border); }
        .insight-text { font-size: 0.95rem; color: var(--text-main); margin-bottom: 6px; }
        .insight-label { font-size: 0.75rem; text-transform: uppercase; color: var(--text-light); letter-spacing: 1px; margin-bottom: 4px; display: block;}

        /* UTILS */
        .btn-action { display: block; width: 100%; padding: 12px; background: var(--text-main); color: white; border: none; border-radius: var(--radius); font-size: 1rem; margin-top: 12px; cursor: pointer; }
        .btn-secondary { background: white; color: var(--text-main); border: 1px solid var(--border); }
        .frente-chip { display: inline-flex; justify-content: space-between; align-items: center; background: white; border: 1px solid var(--border); padding: 8px 12px; border-radius: 20px; margin: 4px; }
    </style>
</head>
<body>

    <h1 id="app-title">Consciência Diária</h1>
    <div class="date-header" id="current-date">Hoje</div>

    <div id="view-checkin" class="view active">
        <div id="frentes-container"></div>
        <div class="card" style="margin-top: 30px; text-align: center; border: none; box-shadow: none; background: transparent;">
            <p style="font-style: italic; opacity: 0.7;">
                Não force o preenchimento.<br>O silêncio também é um dado.
            </p>
        </div>
    </div>

    <div id="view-reflexao" class="view">
        <div style="padding: 0 var(--spacing);">
            <h2>Leitura de Padrões</h2>
            <p>O que seus registros dizem sobre seu ritmo.</p>
        </div>
        <div id="insights-container"></div>
        <div class="card">
             <h3>Histórico Recente</h3>
             <div id="timeline-container" style="margin-top: 16px;"></div>
        </div>
    </div>

    <div id="view-config" class="view">
        <div class="card">
            <h3>Gerenciar Frentes</h3>
            <p>Adicione ou remova áreas de existência.</p>
            <div id="config-frentes-list" style="margin: 16px 0;"></div>
            <div style="display: flex; gap: 8px;">
                <input type="text" id="new-frente-input" class="note-input" placeholder="Nova frente (ex: Criatividade)">
                <button onclick="addFrente()" style="background:none; border:none; font-weight:bold; color:var(--text-main);">Adicionar</button>
            </div>
        </div>

        <div class="card">
            <h3>Dados</h3>
            <p>Seus dados ficam apenas neste dispositivo.</p>
            <button onclick="exportData()" class="btn-action btn-secondary">Backup (Baixar JSON)</button>
            <br>
            <input type="file" id="import-file" style="display:none" onchange="importData(this)">
            <button onclick="document.getElementById('import-file').click()" class="btn-action btn-secondary">Restaurar Backup</button>
            <br>
            <button onclick="clearData()" class="btn-action" style="background: #FEE2E2; color: #991B1B; border: none;">Apagar Tudo</button>
        </div>
    </div>

    <nav class="nav-bar">
        <button class="nav-item active" onclick="switchView('checkin')">
            <span class="nav-icon">◎</span><span>Check-in</span>
        </button>
        <button class="nav-item" onclick="switchView('reflexao')">
            <span class="nav-icon">◇</span><span>Reflexão</span>
        </button>
        <button class="nav-item" onclick="switchView('config')">
            <span class="nav-icon">⚙</span><span>Ajustes</span>
        </button>
    </nav>

    <script>
        // FRENTES INICIAIS (Conforme Briefing Item 3)
        const DEFAULT_FRENTES = ["Família", "Pastoral", "Lumine", "Retornar", "Pessoal", "Corpo", "Fé"];
        
        let appData = {
            frentes: JSON.parse(JSON.stringify(DEFAULT_FRENTES)),
            registros: {} // Estrutura: "YYYY-MM-DD": { "Frente": {state: "", note: ""} }
        };

        // INICIALIZAÇÃO
        function init() {
            const saved = localStorage.getItem('ritmoVidaData');
            if (saved) {
                try { appData = JSON.parse(saved); } catch(e) {}
            } else {
                saveData();
            }
            // Garante objeto para hoje
            if (!appData.registros[getTodayStr()]) appData.registros[getTodayStr()] = {};

            renderHeader(); renderCheckin(); renderConfig();
        }

        function getTodayStr() { return new Date().toISOString().split('T')[0]; }
        function saveData() { localStorage.setItem('ritmoVidaData', JSON.stringify(appData)); }
        
        // RENDERIZAÇÃO
        function renderCheckin() {
            const container = document.getElementById('frentes-container');
            container.innerHTML = '';
            const todayData = appData.registros[getTodayStr()] || {};

            appData.frentes.forEach(frente => {
                const data = todayData[frente] || { state: null, note: '' };
                const el = document.createElement('div');
                el.className = 'frente-item card';
                el.innerHTML = `
                    <div class="frente-header"><span class="frente-name">${frente}</span></div>
                    <div class="state-selector">
                        <button class="state-btn ${data.state === 'ok' ? 'selected' : ''}" onclick="setEntry('${frente}', 'ok')">Ok</button>
                        <button class="state-btn ${data.state === 'pesado' ? 'selected' : ''}" onclick="setEntry('${frente}', 'pesado')">Pesado</button>
                        <button class="state-btn ${data.state === 'negligenciado' ? 'selected' : ''}" onclick="setEntry('${frente}', 'negligenciado')">Negligenciado</button>
                    </div>
                    <input type="text" class="note-input" placeholder="Nota breve (opcional)" value="${data.note || ''}" onblur="setNote('${frente}', this.value)">
                `;
                container.appendChild(el);
            });
        }

        function setEntry(frente, state) {
            const today = getTodayStr();
            const current = appData.registros[today][frente] || {};
            // Lógica de toggle: se clicar no mesmo, remove
            appData.registros[today][frente] = { ...current, state: (current.state === state ? null : state) };
            saveData(); renderCheckin();
        }

        function setNote(frente, val) {
            const today = getTodayStr();
            if (!appData.registros[today][frente]) appData.registros[today][frente] = {};
            appData.registros[today][frente].note = val;
            saveData();
        }

        // LÓGICA DE INSIGHTS (Briefing Item 7)
        function renderReflexao() {
            const container = document.getElementById('insights-container');
            container.innerHTML = '';
            const msgs = generateInsights();
            
            if (msgs.length === 0) {
                container.innerHTML = '<div class="insight-card neutral"><p class="insight-text">Continue registrando para gerar padrões.</p></div>';
            } else {
                msgs.forEach(txt => {
                    container.innerHTML += `<div class="insight-card"><span class="insight-label">Insight</span><p class="insight-text">${txt}</p></div>`;
                });
            }
            renderTimeline();
        }

        function generateInsights() {
            const msgs = [];
            const dates = Object.keys(appData.registros).sort().reverse();
            if (dates.length < 3) return [];

            // 1. Silêncio
            appData.frentes.forEach(frente => {
                let lastSeen = -1;
                for(let i=0; i<dates.length; i++) {
                    if(appData.registros[dates[i]][frente]?.state) { lastSeen = i; break; }
                }
                if (lastSeen > 7) msgs.push(`A frente <strong>${frente}</strong> está silenciosa há mais de uma semana.`);
            });
            return msgs.slice(0, 3);
        }

        function renderTimeline() {
            const container = document.getElementById('timeline-container');
            container.innerHTML = '';
            const dates = Object.keys(appData.registros).sort().reverse().slice(0, 14);
            
            dates.forEach(date => {
                const dayData = appData.registros[date];
                const hasData = Object.keys(dayData).some(k => dayData[k].state || dayData[k].note);
                if(!hasData) return;

                let html = `<div class="timeline-date">${new Date(date).toLocaleDateString('pt-BR', {day:'numeric', month:'short'})}</div><div class="timeline-content">`;
                appData.frentes.forEach(f => {
                    if(dayData[f]?.state || dayData[f]?.note) {
                        html += `<div>`;
                        if(dayData[f].state) html += `<span class="tag ${dayData[f].state}">${f}: ${dayData[f].state}</span>`;
                        if(dayData[f].note) html += `<span style="font-size:0.85rem; color:#666"> "${dayData[f].note}"</span>`;
                        html += `</div>`;
                    }
                });
                html += `</div>`;
                const row = document.createElement('div'); row.className = 'timeline-grid'; row.innerHTML = html;
                container.appendChild(row);
            });
        }

        // CONFIG
        function renderConfig() {
            const list = document.getElementById('config-frentes-list');
            list.innerHTML = '';
            appData.frentes.forEach((f, i) => {
                list.innerHTML += `<div class="frente-chip">${f} <span onclick="removeFrente(${i})" style="cursor:pointer;color:red;margin-left:8px">×</span></div>`;
            });
        }

        function addFrente() {
            const val = document.getElementById('new-frente-input').value.trim();
            if(val && !appData.frentes.includes(val)) {
                appData.frentes.push(val); saveData(); renderConfig(); renderCheckin();
                document.getElementById('new-frente-input').value = '';
            }
        }

        function removeFrente(i) {
            if(confirm('Remover frente?')) {
                appData.frentes.splice(i, 1); saveData(); renderConfig(); renderCheckin();
            }
        }

        function exportData() {
            const a = document.createElement('a');
            a.href = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appData));
            a.download = "backup_ritmo_" + getTodayStr() + ".json";
            a.click();
        }

        function importData(input) {
            const r = new FileReader();
            r.onload = e => {
                try { appData = JSON.parse(e.target.result); saveData(); init(); alert('Restaurado!'); }
                catch { alert('Erro no arquivo.'); }
            };
            r.readAsText(input.files[0]);
        }
        
        function clearData() {
            if(confirm('Apagar tudo?')) { localStorage.removeItem('ritmoVidaData'); location.reload(); }
        }

        function renderHeader() {
             document.getElementById('current-date').innerText = new Date().toLocaleDateString('pt-BR', {weekday:'long', day:'numeric', month:'long'});
        }

        function switchView(v) {
            document.querySelectorAll('.view').forEach(e => e.classList.remove('active'));
            document.getElementById('view-'+v).classList.add('active');
            document.querySelectorAll('.nav-item').forEach(e => e.classList.remove('active'));
            // Lógica simples para ativar ícone correto
            const idx = v === 'checkin' ? 0 : v === 'reflexao' ? 1 : 2;
            document.querySelectorAll('.nav-item')[idx].classList.add('active');
            if(v==='reflexao') renderReflexao();
        }

        init();
    </script>
</body>
</html>
